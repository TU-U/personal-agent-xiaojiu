# Node 24: node --env-file=.env server/index.mjs
PORT=4317
HOST=0.0.0.0
# On a fresh database, set a private access code before importing personal data.
# DEMO_ACCESS_CODE=replace-with-your-own-code
# DATA_DIR=.data
# Optional Chat Completions-compatible model:
# LLM_BASE_URL=http://127.0.0.1:4318/v1
# LLM_MODEL=qwen2.5-1.5b-instruct
# LLM_API_KEY=
# Behind HTTPS, enable Secure cookies:
# COOKIE_SECURE=true
